/* =========================================================
   GIFTED HANDS
   GLOBAL STYLE — ALL PAGES
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap');


:root {
    --black: #080808;
    --dark: #0d0d0d;
    --dark-2: #111111;
    --gold: #c8a45d;
    --gold-light: #d8b76c;
    --white: #f5f5f5;
    --text: #c3c3c3;
    --muted: #888;
    --border: rgba(255,255,255,0.10);
}


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    background: var(--black);
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    overflow-x: hidden;
}


a {
    color: inherit;
    text-decoration: none;
}


img {
    display: block;
    max-width: 100%;
}


button,
a {
    -webkit-tap-highlight-color: transparent;
}


/* =========================================================
   HEADER
   ========================================================= */

.site-header {
    position: absolute;
    z-index: 1000;
    top: 0;
    left: 0;

    width: 100%;
    height: 92px;

    padding: 0 5.5%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid rgba(255,255,255,0.05);
}


/* LOGO */

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}


.logo-mark {
    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--gold);
    border-radius: 10px;

    color: var(--gold);
    font-size: 21px;
}


.logo-text {
    display: flex;
    flex-direction: column;
}


.logo-text strong {
    color: var(--gold-light);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 1px;
}


.logo-text small {
    margin-top: 3px;

    color: #aaa;
    font-size: 7px;
    letter-spacing: 1.5px;
}


/* NAVIGATION */

.main-nav {
    display: flex;
    align-items: center;
    gap: 32px;
}


.main-nav a {
    position: relative;

    color: #ddd;

    font-size: 11px;
    font-weight: 500;

    transition: .3s ease;
}


.main-nav a:hover,
.main-nav a.active {
    color: var(--gold);
}


.main-nav a.active::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: -17px;

    height: 2px;

    background: var(--gold);
}


/* HEADER SOCIALS */

.nav-socials {
    display: flex;
    align-items: center;
    gap: 10px;
}


.nav-socials a {
    width: 29px;
    height: 29px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(200,164,93,.35);
    border-radius: 50%;

    color: var(--gold);

    font-size: 11px;

    transition: .3s ease;
}


.nav-socials a:hover {
    background: var(--gold);
    color: #080808;
    transform: translateY(-3px);
}


/* =========================================================
   GENERAL PAGE HERO
   ========================================================= */

.page-hero {
    position: relative;

    height: 470px;
    width: 100%;

    display: flex;
    align-items: center;

    padding: 100px 7% 50px;

    overflow: hidden;

    background:
        linear-gradient(
            90deg,
            rgba(5,5,5,.98),
            rgba(5,5,5,.80),
            rgba(5,5,5,.35)
        ),
        url("hero.jpg");

    background-size: cover;
    background-position: center;
}


.page-hero::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            0deg,
            rgba(8,8,8,.95),
            transparent 40%
        );

    pointer-events: none;
}


.page-hero-content {
    position: relative;
    z-index: 2;

    max-width: 650px;
}


.section-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    margin-bottom: 18px;

    color: var(--gold);

    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}


.section-label i {
    width: 20px;
    height: 1px;

    display: inline-block;

    background: var(--gold);
}


.page-hero h1 {
    font-family: 'Cormorant Garamond', serif;

    font-size: 76px;
    line-height: .9;
    font-weight: 600;
}


.page-hero h1 span {
    color: var(--gold-light);
}


.page-hero p {
    max-width: 480px;

    margin-top: 22px;

    color: #aaa;

    font-size: 13px;
    line-height: 1.8;
}


/* =========================================================
   ABOUT PAGE
   ========================================================= */

.about-section {
    width: 90%;

    margin: 0 auto;

    padding: 90px 0;

    display: grid;
    grid-template-columns: 1.25fr .75fr;

    gap: 80px;

    align-items: center;
}


.about-content h2 {
    max-width: 650px;

    margin-bottom: 30px;

    font-family: 'Cormorant Garamond', serif;

    font-size: 55px;
    line-height: .95;
}


.about-content h2 span {
    color: var(--gold);
}


.about-content p {
    max-width: 700px;

    margin-bottom: 18px;

    color: var(--text);

    font-size: 13px;
    line-height: 1.9;
}


/* ABOUT HIGHLIGHT */

.about-highlight {
    min-height: 430px;

    padding: 45px 35px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            145deg,
            #161616,
            #0c0c0c
        );

    border: 1px solid var(--border);
    border-radius: 18px;

    box-shadow: 0 20px 70px rgba(0,0,0,.35);
}


.highlight-icon {
    width: 85px;
    height: 85px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 25px;

    border: 1px solid var(--gold);
    border-radius: 50%;

    color: var(--gold);

    font-size: 31px;
}


.about-highlight h3 {
    max-width: 320px;

    font-family: 'Cormorant Garamond', serif;

    color: #eee;

    font-size: 30px;
    line-height: 1.1;
}


.gold-line {
    width: 55px;
    height: 1px;

    margin: 25px 0;

    background: var(--gold);
}


.about-highlight p {
    color: var(--gold-light);

    font-size: 12px;
    letter-spacing: 1px;
}


.chairs {
    margin-top: 20px;
    font-size: 27px;
}


/* =========================================================
   VALUES
   ========================================================= */

.values-section {
    padding: 80px 5% 100px;

    background: #0c0c0c;
}


.section-heading {
    margin-bottom: 45px;

    text-align: center;
}


.section-heading h2 {
    font-family: 'Cormorant Garamond', serif;

    font-size: 52px;
}


.section-heading h2 span {
    color: var(--gold);
}


.values-grid {
    max-width: 1200px;

    margin: auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}


.value-card {
    padding: 35px 25px;

    background: #111;

    border: 1px solid var(--border);
    border-radius: 12px;

    transition: .4s ease;
}


.value-card:hover {
    border-color: rgba(200,164,93,.55);
    transform: translateY(-7px);
}


.value-icon {
    width: 48px;
    height: 48px;

    margin-bottom: 23px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--gold);

    border: 1px solid rgba(200,164,93,.4);
    border-radius: 8px;
}


.value-card h3 {
    margin-bottom: 12px;

    font-size: 14px;
    letter-spacing: .5px;
}


.value-card p {
    color: #999;

    font-size: 11px;
    line-height: 1.8;
}


/* =========================================================
   SERVICES PAGE
   ========================================================= */

.services-page {
    width: 90%;

    margin: auto;

    padding: 90px 0 100px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}


.service-large-card {
    min-height: 300px;

    padding: 35px 27px;

    background:
        linear-gradient(
            145deg,
            #151515,
            #0d0d0d
        );

    border: 1px solid var(--border);
    border-radius: 12px;

    transition: .4s ease;
}


.service-large-card:hover {
    transform: translateY(-8px);

    border-color: rgba(200,164,93,.6);

    box-shadow: 0 20px 50px rgba(0,0,0,.3);
}


.service-large-card > i {
    width: 58px;
    height: 58px;

    margin-bottom: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--gold);

    border: 1px solid rgba(200,164,93,.5);
    border-radius: 50%;

    font-size: 22px;
}


.service-large-card h2 {
    margin-bottom: 14px;

    font-family: 'Cormorant Garamond', serif;

    font-size: 27px;
}


.service-large-card p {
    color: #999;

    font-size: 11px;
    line-height: 1.8;
}


/* =========================================================
   CONTACT PAGE
   ========================================================= */

.contact-page {
    width: 90%;

    margin: auto;

    padding: 90px 0 100px;
}


.contact-intro {
    max-width: 700px;

    margin-bottom: 55px;
}


.contact-intro h2 {
    margin-bottom: 22px;

    font-family: 'Cormorant Garamond', serif;

    font-size: 58px;
    line-height: .95;
}


.contact-intro h2 span {
    color: var(--gold);
}


.contact-intro p {
    color: #999;

    font-size: 13px;
    line-height: 1.8;
}


.contact-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 18px;
}


.contact-card {
    min-height: 125px;

    padding: 25px;

    display: flex;
    align-items: center;

    gap: 20px;

    background: #111;

    border: 1px solid var(--border);
    border-radius: 12px;

    transition: .35s ease;
}


.contact-card:hover {
    border-color: rgba(200,164,93,.6);

    transform: translateY(-5px);
}


.contact-icon {
    width: 55px;
    height: 55px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(200,164,93,.5);
    border-radius: 50%;

    color: var(--gold);

    font-size: 20px;
}


.contact-icon.whatsapp {
    border-color: #25d366;
    color: #25d366;
}


.contact-card span {
    color: var(--gold);

    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.5px;
}


.contact-card h3 {
    margin: 7px 0;

    font-size: 15px;
}


.contact-card p {
    color: #888;

    font-size: 10px;
}


.contact-social-section {
    margin-top: 55px;

    padding: 40px;

    text-align: center;

    background: #101010;

    border: 1px solid var(--border);
    border-radius: 14px;
}


.contact-social-section > span {
    color: var(--gold);

    font-size: 9px;
    letter-spacing: 2px;
}


.social-icons {
    margin-top: 20px;

    display: flex;
    justify-content: center;
    flex-wrap: wrap;

    gap: 10px;
}


.social-icons a {
    width: 39px;
    height: 39px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(200,164,93,.4);
    border-radius: 50%;

    color: var(--gold);

    font-size: 14px;

    transition: .3s ease;
}


.social-icons a:hover {
    background: var(--gold);
    color: #080808;

    transform: translateY(-4px);
}


.social-icons.large {
    gap: 13px;
}


.social-icons.large a {
    width: 48px;
    height: 48px;

    font-size: 17px;
}


/* =========================================================
   CTA BANNER
   ========================================================= */

.cta-banner {
    width: 90%;

    margin: 0 auto 70px;

    min-height: 125px;

    padding: 28px 42px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background:
        linear-gradient(
            135deg,
            #151515,
            #0e0e0e
        );

    border: 1px solid var(--border);
    border-radius: 16px;
}


.cta-banner span {
    color: var(--gold);

    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.5px;
}


.cta-banner h2 {
    margin-top: 7px;

    font-family: 'Cormorant Garamond', serif;

    font-size: 32px;
}


.gold-button {
    min-height: 44px;

    padding: 0 22px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    border-radius: 5px;

    background: var(--gold);

    color: #090909;

    font-size: 9px;
    font-weight: 700;
    letter-spacing: .8px;

    transition: .3s ease;
}


.gold-button:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
}


/* =========================================================
   FOOTER
   ========================================================= */

.site-footer {
    padding: 65px 6% 25px;

    border-top: 1px solid rgba(255,255,255,.07);

    background: #070707;
}


.footer-top {
    display: grid;
    grid-template-columns: 1.4fr .8fr 1fr;

    gap: 70px;

    padding-bottom: 45px;
}


.footer-brand h2 {
    color: var(--gold);

    font-size: 19px;
    letter-spacing: 1px;
}


.footer-brand p {
    margin: 5px 0 12px;

    color: #aaa;

    font-size: 8px;
    letter-spacing: 1.3px;
    text-transform: uppercase;
}


.footer-brand span {
    color: #666;

    font-family: 'Cormorant Garamond', serif;

    font-size: 17px;
}


.footer-links,
.footer-social {
    display: flex;
    flex-direction: column;
}


.footer-links h3,
.footer-social h3 {
    margin-bottom: 18px;

    color: var(--gold);

    font-size: 9px;
    letter-spacing: 1.5px;
}


.footer-links a {
    margin-bottom: 10px;

    color: #777;

    font-size: 10px;

    transition: .3s;
}


.footer-links a:hover {
    color: var(--gold);
}


.footer-social .social-icons {
    justify-content: flex-start;

    margin-top: 0;
}


.footer-social .social-icons a {
    width: 33px;
    height: 33px;

    font-size: 12px;
}


.footer-bottom {
    padding-top: 22px;

    border-top: 1px solid rgba(255,255,255,.07);

    text-align: center;
}


.footer-bottom p {
    color: #555;

    font-size: 8px;
}


/* =========================================================
   WHATSAPP FLOATING BUTTON
   ========================================================= */

.whatsapp-float {
    position: fixed;

    right: 25px;
    bottom: 25px;

    z-index: 9999;

    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #25d366;

    color: white;

    font-size: 25px;

    box-shadow: 0 8px 30px rgba(0,0,0,.5);

    transition: .3s ease;
}


.whatsapp-float:hover {
    transform: scale(1.1);

    box-shadow: 0 10px 35px rgba(37,211,102,.25);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {

    .site-header {
        height: 80px;
        padding: 0 20px;
    }


    .nav-socials {
        display: none;
    }


    .main-nav {
        gap: 15px;
    }


    .main-nav a {
        font-size: 8px;
    }


    .main-nav a.active::after {
        bottom: -12px;
    }


    .page-hero {
        height: 410px;
        padding: 110px 25px 40px;
    }


    .page-hero h1 {
        font-size: 55px;
    }


    .page-hero p {
        font-size: 10px;
    }


    .about-section {
        grid-template-columns: 1fr;

        gap: 45px;

        padding: 65px 0;
    }


    .about-content h2 {
        font-size: 45px;
    }


    .about-content p {
        font-size: 11px;
    }


    .values-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    .services-page {
        grid-template-columns: repeat(2, 1fr);

        padding: 65px 0 80px;
    }


    .contact-intro h2 {
        font-size: 47px;
    }


    .footer-top {
        grid-template-columns: 1fr 1fr;
    }

}


/* =========================================================
   PHONE — ZOOMED FEEL
   ========================================================= */

@media (max-width: 600px) {

    .site-header {
        height: 75px;
        padding: 0 15px;
    }


    .logo {
        gap: 7px;
    }


    .logo-mark {
        width: 34px;
        height: 34px;

        font-size: 15px;
    }


    .logo-text strong {
        font-size: 12px;
    }


    .logo-text small {
        font-size: 5px;
        letter-spacing: 1px;
    }


    .main-nav {
        gap: 8px;
    }


    .main-nav a {
        font-size: 6.5px;
    }


    .page-hero {
        height: 370px;

        padding: 105px 22px 35px;

        background-position: 62% center;
    }


    .page-hero::before {
        content: "";

        position: absolute;

        inset: 0;

        background: rgba(0,0,0,.08);

        transform: scale(1.12);
    }


    .page-hero h1 {
        font-size: 48px;
    }


    .page-hero p {
        max-width: 280px;

        font-size: 9px;

        line-height: 1.7;
    }


    .section-label {
        font-size: 7px;
        gap: 8px;
    }


    .section-label i {
        width: 14px;
    }


    /* ABOUT */

    .about-section {
        width: 90%;

        padding: 55px 0;

        gap: 35px;
    }


    .about-content h2 {
        font-size: 40px;
    }


    .about-content p {
        font-size: 10px;
        line-height: 1.8;
    }


    .about-highlight {
        min-height: 340px;

        padding: 30px 20px;
    }


    .highlight-icon {
        width: 65px;
        height: 65px;

        font-size: 23px;
    }


    .about-highlight h3 {
        font-size: 25px;
    }


    .about-highlight p {
        font-size: 9px;
    }


    /* VALUES */

    .values-section {
        padding: 60px 5%;
    }


    .section-heading h2 {
        font-size: 42px;
    }


    .values-grid {
        grid-template-columns: 1fr 1fr;

        gap: 10px;
    }


    .value-card {
        min-height: 190px;

        padding: 23px 16px;
    }


    .value-icon {
        width: 38px;
        height: 38px;

        font-size: 13px;
    }


    .value-card h3 {
        font-size: 10px;
    }


    .value-card p {
        font-size: 8px;
        line-height: 1.7;
    }


    /* SERVICES */

    .services-page {
        width: 90%;

        grid-template-columns: 1fr 1fr;

        gap: 10px;

        padding: 55px 0 65px;
    }


    .service-large-card {
        min-height: 220px;

        padding: 22px 15px;
    }


    .service-large-card > i {
        width: 43px;
        height: 43px;

        margin-bottom: 20px;

        font-size: 15px;
    }


    .service-large-card h2 {
        font-size: 21px;
    }


    .service-large-card p {
        font-size: 8px;
        line-height: 1.7;
    }


    /* CONTACT */

    .contact-page {
        width: 90%;

        padding: 55px 0 70px;
    }


    .contact-intro h2 {
        font-size: 40px;
    }


    .contact-intro p {
        font-size: 10px;
    }


    .contact-cards {
        grid-template-columns: 1fr;

        gap: 10px;
    }


    .contact-card {
        min-height: 95px;

        padding: 18px;

        gap: 15px;
    }


    .contact-icon {
        width: 43px;
        height: 43px;

        font-size: 15px;
    }


    .contact-card span {
        font-size: 6px;
    }


    .contact-card h3 {
        font-size: 12px;
    }


    .contact-card p {
        font-size: 8px;
    }


    .contact-social-section {
        padding: 25px 15px;
    }


    .social-icons.large a {
        width: 38px;
        height: 38px;

        font-size: 13px;
    }


    /* CTA */

    .cta-banner {
        width: 90%;

        padding: 25px 20px;

        min-height: 120px;

        flex-direction: column;

        align-items: flex-start;

        gap: 20px;
    }


    .cta-banner h2 {
        font-size: 27px;
    }


    .gold-button {
        min-height: 39px;

        font-size: 7px;
    }


    /* FOOTER */

    .site-footer {
        padding: 45px 20px 20px;
    }


    .footer-top {
        grid-template-columns: 1fr 1fr;

        gap: 35px;
    }


    .footer-brand {
        grid-column: 1 / -1;
    }


    .footer-brand h2 {
        font-size: 16px;
    }


    .footer-brand span {
        font-size: 14px;
    }


    .footer-links h3,
    .footer-social h3 {
        font-size: 7px;
    }


    .footer-links a {
        font-size: 8px;
    }


    .footer-social .social-icons {
        gap: 6px;
    }


    .footer-social .social-icons a {
        width: 27px;
        height: 27px;

        font-size: 9px;
    }


    .footer-bottom p {
        font-size: 6px;
        line-height: 1.6;
    }


    /* WHATSAPP */

    .whatsapp-float {
        width: 48px;
        height: 48px;

        right: 17px;
        bottom: 17px;

        font-size: 21px;
    }

}


/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-width: 380px) {

    .main-nav {
        gap: 6px;
    }


    .main-nav a {
        font-size: 6px;
    }


    .logo-text strong {
        font-size: 11px;
    }


    .page-hero h1 {
        font-size: 43px;
    }


    .about-content h2,
    .contact-intro h2 {
        font-size: 36px;
    }


